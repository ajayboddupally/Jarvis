APP_NAME=Jarvis Intelligence Gateway
ENVIRONMENT=development
API_VERSION=v1
LOG_LEVEL=INFO

JWT_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-long-random-admin-key
API_KEY_PEPPER=replace-with-a-long-random-pepper

DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis
REDIS_URL=redis://localhost:6379/0

INTELLIGENCE_SERVICE_URL=http://localhost:8001
AGENT_SERVICE_URL=http://localhost:8002

REQUEST_TIMEOUT_SECONDS=60
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=1048576
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DEFAULT_MODEL=jarvis-local
MAX_CONTEXT_MESSAGES=20
EXTERNAL_MODEL_URL=
EXTERNAL_MODEL_API_KEY=
EXTERNAL_MODEL_NAME=external-default
MODEL_TIMEOUT_SECONDS=60
